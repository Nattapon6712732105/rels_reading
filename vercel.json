{
  "buildCommand": "bash build.sh",
  "outputDirectory": "build/web",
  "headers": [
    {
      "source": "/(.*)\\.(js|wasm|css|png|jpg|jpeg|gif|ico|woff|woff2|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(index.html|version.json|flutter_service_worker.js|manifest.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
